    \tl_set:Nx \ttsh@ymin { \fp_to_dim:n { min(\ttsh@ya, \ttsh@yb) } }
    \tl_set:Nx \ttsh@ymax { \fp_to_dim:n { max(\ttsh@ya, \ttsh@yb) } }
    \tl_set:Nx \ttsh@xc   { \fp_to_dim:n { (\ttsh@xa + \ttsh@xb) / 2 } }
    \tl_set:Nx \ttsh@yc   { \fp_to_dim:n { (\ttsh@ya + \ttsh@yb) / 2 } }
    \tl_set:Nx \ttsh@rx   { \fp_to_dim:n { abs(\ttsh@xb - \ttsh@xa) / 2 } }
    \tl_set:Nx \ttsh@ry   { \fp_to_dim:n { abs(\ttsh@yb - \ttsh@ya) / 2 } }
    \tl_set:Nx \ttsh@pos
