      { \fp_to_dim:n { ( \seq_item:Nn \l_tmpa_seq { 1 } ) * \l__tt_sh_w_dim } }
    \tl_set:cx { ttsh@y #2 }
      { \fp_to_dim:n { ( \seq_item:Nn \l_tmpa_seq { 2 } ) * \l__tt_sh_h_dim
