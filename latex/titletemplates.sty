    fill     .initial:n  = none,
    opacity  .tl_set:N   = \ttsh@opacity,
    opacity  .initial:n  = ,
    border   .tl_set:N   = \ttsh@border,
    border   .initial:n  = none,
    border   .default:n  = true,
    dashed   .code:n     = { \str_if_eq:nnTF {#1} {false}
