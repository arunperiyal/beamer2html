% animate shows its frames as PDF widget annotations, which viewers draw above
% all page content. Shapes and slide shapes on a page with an
% animation therefore become an annotation of their own (a read-only stamp
% whose appearance is the drawing), added after animate's so it is drawn on
% top. pdfTeX only; elsewhere, and on pages without animations, the drawing
% stays ordinary page content.
\bool_new:N \g__tt_anim_page_bool     % this page has an animation
\bool_new:N \g__tt_anim_seen_bool     % the current annotate holds one
\box_new:N  \l__tt_over_box       % \__tt_over:N's own
\box_new:N  \l__tt_over_in_box    % the drawing handed to it
\dim_const:Nn \c__tt_over_margin_dim { 30pt }   % room for labels outside the box
\cs_new_protected:Npn \__tt_over:N #1
  {
    \bool_lazy_and:nnTF { \sys_if_engine_pdftex_p: } { \g__tt_anim_page_bool }
      {
        \hbox_set:Nn \l__tt_over_box
          { \skip_horizontal:N \c__tt_over_margin_dim \box_use:N #1
            \skip_horizontal:N \c__tt_over_margin_dim }
        \box_set_ht:Nn \l__tt_over_box { \box_ht:N #1 + \c__tt_over_margin_dim }
        \box_set_dp:Nn \l__tt_over_box { \box_dp:N #1 + \c__tt_over_margin_dim }
        \hbox:n
          {
            \skip_horizontal:n { -\c__tt_over_margin_dim }
            \tex_immediate:D \tex_pdfxform:D \l__tt_over_box
            \tex_pdfannot:D
              width  \dim_eval:n { \box_wd:N #1 + 2 \c__tt_over_margin_dim }
              height \dim_eval:n { \box_ht:N #1 + \c__tt_over_margin_dim }
              depth  \dim_eval:n { \box_dp:N #1 + \c__tt_over_margin_dim }
              { /Subtype /Stamp /F~196 /AP << /N~\int_use:N \tex_pdflastxform:D \c_space_tl 0~R >> }
            \skip_horizontal:n { \c__tt_over_margin_dim + \box_wd:N #1 }
          }
      }
      { \box_use:N #1 }
  }
\dim_new:N  \l__tt_sh_w_dim
\dim_new:N  \l__tt_sh_h_dim
\dim_new:N  \l__tt_sh_yo_dim
\tl_new:N   \g__tt_sh_ann_tl
\tl_new:N   \g__tt_sh_page_tl
\bool_new:N \l__tt_sh_grid_bool
\newsavebox \l__tt_sh_box
\tl_new:N   \l__tt_sh_pos_tl

\keys_define:nn { tt / shape }
