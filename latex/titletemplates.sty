                \exp_not:N \__tt_anim_ptime:nnnn
                  { \seq_item:Nn \l__tt_anim_pfirst_seq {#1} } { \seq_item:Nn \l__tt_anim_pstep_seq {#1} }
                  { \seq_item:Nn \l__tt_anim_pcount_seq {#1} } { \seq_item:Nn \l__tt_anim_pdt_seq {#1} }
              }
          }
      }
      {
        \int_compare:nNnF {#1} = { 1 } { \exp_not:N \hspace* { \dim_use:N \l__tt_anim_gap_dim } }
        \__tt_anim_frame:n {#1}
        \exp_not:N \includegraphics [ width = \dim_use:N \l__tt_anim_w_dim ] { \exp_not:n {#2} }
      }
  }
% \N for panel #1 at animation frame \iK: first + step x min(\iK, n-1)
\cs_new:Npn \__tt_anim_frame:n #1
  {
    \exp_not:N \edef \exp_not:N \N
      { \exp_not:N \int_eval:n { \seq_item:Nn \l__tt_anim_pfirst_seq {#1}
          + \seq_item:Nn \l__tt_anim_pstep_seq {#1}
          * \exp_not:N \int_min:nn { \exp_not:N \iK } { \int_eval:n { \seq_item:Nn \l__tt_anim_pcount_seq {#1} - 1 } } } }
  }
