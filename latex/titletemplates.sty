\cs_generate_variant:Nn \str_case:nnF { VnF }
% one shape, drawn inside a tikzpicture: {options}{kind}{point}{point or text}
\cs_new_protected:Npn \__tt_sh_draw:nnnn #1#2#3#4
  {
