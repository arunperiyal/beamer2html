    \keys_set:nn { tt / shape } {#1}
    \__tt_sh_point:nn {#3} { a }
    \str_if_eq:nnTF {#2} { text }
      { \@ttShapeText {#4} }
      {
    \str_if_eq:nnTF {#2} { axes }                % {origin}{length: fraction of the width}
      {
        \tl_set:Nx \ttsh@len { \fp_to_dim:n { (#4) * \l__tt_sh_w_dim } }
