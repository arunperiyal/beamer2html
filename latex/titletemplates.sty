% #1 rounded to #2 decimals, always printed with #2 decimals (150 -> 150.00)
\cs_new_protected:Npn \__tt_anim_fixed:nn #1 #2
  {
    \int_set:Nn \l_tmpa_int { \fp_eval:n { round( (#1) * 10 ^ (#2) ) } }
    \int_compare:nNnT \l_tmpa_int < { 0 } { - }
    \int_set:Nn \l_tmpb_int { \int_abs:n { \l_tmpa_int } }
    \int_eval:n { \int_div_truncate:nn { \l_tmpb_int } { \fp_eval:n { 10 ^ (#2) } } }
    \int_compare:nNnT { #2 } > { 0 }
      {
        .
        \tl_set:Nx \l_tmpa_tl { \int_eval:n { \int_mod:nn { \l_tmpb_int } { \fp_eval:n { 10 ^ (#2) } } } }
        \prg_replicate:nn { (#2) - \tl_count:N \l_tmpa_tl } { 0 }
