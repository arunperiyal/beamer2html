              { \l__tt_anim_grid_bool
                && \int_compare_p:nNn { \int_mod:nn { #1 - 1 } { \l__tt_anim_cols_int } } = { 0 } }
              { \exp_not:N \par \exp_not:N \vspace { 0.4em } }      % next row
              { \exp_not:N \hspace* { \dim_use:N \l__tt_anim_gap_dim } }
          }
        \exp_not:N \parbox [ t ] { \dim_use:N \l__tt_anim_w_dim }
          {
