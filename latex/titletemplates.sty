% \cmd{shape} -> \shape in typewriter type (for slides about LaTeX itself)
\newcommand{\cmd}[1]{\texttt{\textbackslash #1}}

% ---------------------------------------------------------------- Shapes
%   \begin{annotate}[grid]            shapes over an element: fractions of its
%     \includegraphics[...]{...}      width/height, origin bottom left
%     \shape<2->[color=green!60!black]{rect}{0.45,0.05}{0.56,0.95}
%   \end{annotate}
%   \slideshape[...]{arrow}{0.1,0.2}{0.3,0.4}   fractions of the whole slide
%   \slidegrid                                  coordinate grid on this slide
% Kinds: rect, ellipse (circle), line, arrow: {x1,y1}{x2,y2} (ellipse: its
% bounding box); text: {x,y}{text}; axes: {x,y}{length} -- a coordinate
% indicator, length a fraction of the width (xlabel=$x$, ylabel=$y$,
% zlabel= adds an oblique z axis, oblique=its angle from x (225), rotate=
% degrees; an empty label leaves that axis out). Options: color (red), width (1pt),
% fill (none), opacity (of the fill: 0.25, text 1), dashed, rounded (3pt),
% border (text only: a frame, in the text colour or border=<colour>), label,
% labelpos (above/below/left/right), textsize (\small). <spec> as in beamer.
% Shapes never change the layout. annotate shows a grid (0.1 steps) with
% the grid option or while \showdividers is on, to read off coordinates.
\usetikzlibrary{arrows.meta}
\newif\ifttsh@dashed
\def\ttsh@none{none}
\def\ttsh@true{true}
\newcommand{\@ttShapeStyle}{%
  \tikzset{ttshape/.style={draw=\ttsh@color, line width=\ttsh@width,
                           rounded corners=\ttsh@rounded}}%
  \ifttsh@dashed\tikzset{ttshape/.append style={dashed}}\fi
  \ifx\ttsh@fill\ttsh@none\else
    \tikzset{ttshape/.append style={fill=\ttsh@fill,
      fill opacity=\ifx\ttsh@opacity\@empty 0.25\else\ttsh@opacity\fi}}\fi}
\newcommand{\@ttShapeLabel}[3]{% anchor, x, y
  \ifx\ttsh@label\@empty\else
    \node[anchor=#1, text=\ttsh@color, font=\ttsh@size, inner sep=2pt]
      at (#2,#3) {\ttsh@label};\fi}
\newcommand{\@ttShapeLabelAt}{%
  \ifcase\ttsh@pos\relax
       \@ttShapeLabel{south}{\ttsh@xc}{\ttsh@ymax}%
  \or  \@ttShapeLabel{north}{\ttsh@xc}{\ttsh@ymin}%
  \or  \@ttShapeLabel{east}{\ttsh@xmin}{\ttsh@yc}%
  \or  \@ttShapeLabel{west}{\ttsh@xmax}{\ttsh@yc}\fi}
\newcommand{\@ttShapeRect}{\@ttShapeStyle
  \draw[ttshape] (\ttsh@xa,\ttsh@ya) rectangle (\ttsh@xb,\ttsh@yb);\@ttShapeLabelAt}
\newcommand{\@ttShapeEllipse}{\@ttShapeStyle
  \draw[ttshape] (\ttsh@xc,\ttsh@yc) ellipse [x radius=\ttsh@rx, y radius=\ttsh@ry];%
  \@ttShapeLabelAt}
\newcommand{\@ttShapeLine}[1]{\@ttShapeStyle
  \draw[ttshape, fill=none, #1] (\ttsh@xa,\ttsh@ya) -- (\ttsh@xb,\ttsh@yb);\@ttShapeLabelAt}
% text: fill = background (opaque unless opacity is given), border = frame
% (bare: in the text colour) drawn with width / dashed / rounded
\newcommand{\@ttShapeText}[1]{%
  \tikzset{ttshape/.style={text=\ttsh@color, font=\ttsh@size, inner sep=1pt}}%
  \ifx\ttsh@fill\ttsh@none\else
    \tikzset{ttshape/.append style={inner sep=2.5pt, fill=\ttsh@fill, text opacity=1,
      fill opacity=\ifx\ttsh@opacity\@empty 1\else\ttsh@opacity\fi}}\fi
  \ifx\ttsh@border\ttsh@none\else
    \ifx\ttsh@border\ttsh@true\let\ttsh@border\ttsh@color\fi
    \tikzset{ttshape/.append style={inner sep=2.5pt, draw=\ttsh@border,
      line width=\ttsh@width, rounded corners=\ttsh@rounded}}%
    \ifttsh@dashed\tikzset{ttshape/.append style={dashed}}\fi\fi
  \node[ttshape] at (\ttsh@xa,\ttsh@ya) {#1};}
% axes: arrows from (\ttsh@xa,\ttsh@ya), \ttsh@len long, x at \ttsh@rot degrees,
% y at +90, an oblique z (0.7 long, at +\ttsh@obl); an axis with an empty
% label is left out; the labels sit just beyond the arrow tips
\newcommand{\@ttShapeAxis}[3]{% angle, length factor, label
  \pgfmathsetmacro\ttsh@a{#1}\pgfmathsetmacro\ttsh@b{#1+180}%
  \draw[ttshape, fill=none, -{Stealth}] (\ttsh@xa,\ttsh@ya) -- ++(\ttsh@a:#2*\ttsh@len)
    node[anchor=\ttsh@b, text=\ttsh@color, font=\ttsh@size, inner sep=1.5pt] {#3};}
\newcommand{\@ttShapeAxes}{\@ttShapeStyle
  \ifx\ttsh@xlabel\@empty\else\@ttShapeAxis{\ttsh@rot}{1}{\ttsh@xlabel}\fi
  \ifx\ttsh@ylabel\@empty\else\@ttShapeAxis{\ttsh@rot+90}{1}{\ttsh@ylabel}\fi
  \ifx\ttsh@zlabel\@empty\else\@ttShapeAxis{\ttsh@rot+\ttsh@obl}{0.7}{\ttsh@zlabel}\fi}
% grid over \ttsh@W x \ttsh@H (origin bottom left, shifted by \ttsh@yo);
% numbers outside an element, inside the page edge for \slidegrid
\def\ttsh@xanchor{north}\def\ttsh@yanchor{east}
\newcommand{\@ttShapeGrid}{%
  \foreach \ttsh@i in {0,...,10}{%
    \pgfmathsetmacro\ttsh@f{\ttsh@i/10}%
    \ifodd\ttsh@i\def\ttsh@lw{0.2pt}\else\def\ttsh@lw{0.4pt}\fi
    \draw[dividercolor, line width=\ttsh@lw, opacity=0.6]
      (\ttsh@f*\ttsh@W,\ttsh@yo) -- ++(0,\ttsh@H)
      (0,\ttsh@yo+\ttsh@f*\ttsh@H) -- ++(\ttsh@W,0);
    \ifodd\ttsh@i\else
      \node[font=\tiny\sffamily, text=dividercolor, fill=white, fill opacity=0.7,
            text opacity=1, inner sep=0.5pt, anchor=\ttsh@xanchor]
        at (\ttsh@f*\ttsh@W,\ttsh@yo) {\pgfmathprintnumber[fixed,precision=1]{\ttsh@f}};
      \node[font=\tiny\sffamily, text=dividercolor, fill=white, fill opacity=0.7,
            text opacity=1, inner sep=0.5pt, anchor=\ttsh@yanchor]
        at (0,\ttsh@yo+\ttsh@f*\ttsh@H) {\pgfmathprintnumber[fixed,precision=1]{\ttsh@f}};
    \fi}}
% #1: the shapes; a picture whose origin is the current point
\newcommand{\@ttShapePicture}[1]{%
  \begin{tikzpicture}[overlay]#1\end{tikzpicture}}
% the shapes alone, in a picture of the annotated element's size
\newcommand{\@ttShapesPicture}[2]{% shapes, grid?
  \begin{tikzpicture}
    \path (0,0) rectangle (\ttsh@W,\ttsh@H);
    #2#1
  \end{tikzpicture}}
\newcommand{\@ttAnnotatePicture}[3]{% box, shapes, grid?
  \begin{tikzpicture}[baseline=(ttbox.south)]
    \node[inner sep=0pt, anchor=south west] (ttbox) at (0,0) {\usebox{#1}};
    \begin{scope}[overlay]#3#2\end{scope}
  \end{tikzpicture}}

