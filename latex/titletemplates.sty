    \leavevmode
    \bool_lazy_and:nnTF { \sys_if_engine_pdftex_p: } { \g__tt_anim_seen_bool }
      {                                          % over an animation: the content,
        \hbox_overlap_right:n                    % then the shapes as a stamp
          { \@ttAnnotatePicture { \l__tt_sh_box } { } { } }
        \hbox_set:Nn \l__tt_over_in_box
          {
            \@ttShapesPicture { \g__tt_sh_ann_tl }
              { \bool_if:NT \l__tt_sh_grid_bool { \@ttShapeGrid } }
          }
        \__tt_over:N \l__tt_over_in_box
      }
      {
        \@ttAnnotatePicture { \l__tt_sh_box } { \g__tt_sh_ann_tl }
          { \bool_if:NT \l__tt_sh_grid_bool { \@ttShapeGrid } }
      }
    \tl_gclear:N \g__tt_sh_ann_tl
  }

% slide shapes go on top of the finished page (origin: its top left corner)
\AddToHook { shipout / foreground }
  {
    \tl_if_empty:NF \g__tt_sh_page_tl
      {
        \dim_set_eq:NN \l__tt_sh_w_dim \paperwidth
        \dim_set_eq:NN \l__tt_sh_h_dim \paperheight
        \dim_set:Nn \l__tt_sh_yo_dim { -\paperheight }
        \tl_set:Nx \ttsh@W  { \dim_use:N \paperwidth }
        \tl_set:Nx \ttsh@H  { \dim_use:N \paperheight }
        \tl_set:Nx \ttsh@yo { \dim_eval:n { -\paperheight } }
        \bool_lazy_and:nnTF { \sys_if_engine_pdftex_p: } { \g__tt_anim_page_bool }
          {                                      % a page-sized picture, as a stamp
            \hbox_set:Nn \l__tt_over_in_box
              {
                \begin{tikzpicture}
                  \path (0,-\paperheight) rectangle (\paperwidth,0);
                  \g__tt_sh_page_tl
                \end{tikzpicture}
              }
            \put(0,0){ \rlap { \raisebox { -\paperheight } { \__tt_over:N \l__tt_over_in_box } } }
          }
          { \put(0,0){ \@ttShapePicture { \g__tt_sh_page_tl } } }
        \tl_gclear:N \g__tt_sh_page_tl
      }
    \bool_gset_false:N \g__tt_anim_page_bool
  }
\ExplSyntaxOff

% ---------------------------------------------------------------- Flow diagrams
% TikZ styles for flowcharts in the deck's colours:
%   \begin{tikzpicture}[flow]
%     \node[flowstart]                     (s) {Start};
%     \node[flowbox, below=of s]           (a) {Mesh};
%     \node[flowdecision, below=of a]      (d) {Converged?};
%     \draw[flowarrow] (s) -- (a);
%     \draw[flowarrow] (a) -- (d);
%     \draw[flowarrow] (d.east) -- ++(6mm,0) |- node[flowlabel, near start] {no} (a);
%   \end{tikzpicture}
% flow (on the picture): node distance 6mm and 10mm, \small. Nodes: flowbox
% (a step), flowstart (start/end), flowdecision (a question), flowio (input/
% output). flowarrow for the arrows, flowlabel for text on them. Step by
% step: \node<2->[...] (takes its space only from step 2), or visible on=<2->
% (overlay-beamer-styles: keeps its space, so nothing moves).
\usetikzlibrary{shapes.geometric, shapes.misc, positioning, graphs}
\IfFileExists{tikzlibraryoverlay-beamer-styles.code.tex}
  {\usetikzlibrary{overlay-beamer-styles}}{}
\tikzset{
  flow/.style={node distance=6mm and 10mm, font=\small},
  flownode/.style={draw=bannerblue, line width=0.8pt, align=center, text=black,
                   minimum height=8mm, inner sep=4pt},
  flowbox/.style={flownode, rectangle, rounded corners=2pt, fill=bannerblue!8,
                  minimum width=24mm},
  flowstart/.style={flownode, rounded rectangle, fill=bannerblue!22, minimum width=20mm},
  flowdecision/.style={flownode, diamond, aspect=2, inner sep=1pt,
                       draw=statusongoing!80!black, fill=statusongoing!15},
  flowio/.style={flownode, trapezium, trapezium left angle=70, trapezium right angle=110,
                 trapezium stretches body, fill=white, minimum width=22mm},
  flowarrow/.style={draw=black!70, line width=0.8pt, -{Stealth[length=2.2mm]}},
  flowlabel/.style={font=\footnotesize, fill=white, inner sep=1pt, text=black!70},
}

